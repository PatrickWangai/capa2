# ═══════════════════════════════════════════════════════════
#  Capa — Environment Variables
#  Copy to .env and fill in your values before running.
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://capa:capadev@localhost:5432/capa
# For Docker: postgresql://capa:capadev@postgres:5432/capa

# ── Cache (Redis) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# For Docker with password: redis://:redisdev@redis:6379

# ── JWT Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Required — no insecure default is used if these are unset, the app will refuse to start.
JWT_SECRET=replace-with-64-char-random-hex-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-hex-string
JWT_EXPIRES_IN=15m
# NOT READ BY ANY CODE — refresh token lifetime is set in config/jwt.js.
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ── Error monitoring (Sentry) ────────────────────────────
# Optional — leave unset to disable. Get a DSN from sentry.io.
SENTRY_DSN=
VITE_SENTRY_DSN=

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Where the app is served from — used to build links in outgoing email.
FRONTEND_URL=http://localhost:5173

# ── Admin seeding ────────────────────────────────────────
# Required in production. Without these the seeded admin accounts keep their
# default passwords.
ADMIN_PASSWORD=
ADMIN2_PASSWORD=

# ── MFA ──────────────────────────────────────────────────
# Required in production. Encrypts stored MFA secrets; empty means unprotected.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# ── Frontend (Vite) ──────────────────────────────────────
VITE_API_URL=http://localhost:4000
# Base path for the build, e.g. "/app/". Leave unset for root.
VITE_BASE=
# Google Analytics measurement ID. Optional — analytics is skipped when unset.
VITE_GA_MEASUREMENT_ID=
# NOT READ BY ANY CODE — the socket connects to VITE_API_URL's origin.
VITE_WS_URL=ws://localhost:4000

# ── AWS S3 (KYC document storage) ────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=capa-kyc-documents

# ── Email (SMTP / SendGrid) ──────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@capa.invest

# ── M-Pesa (Safaricom Daraja API) ────────────────────────
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_PASSKEY=your-daraja-passkey
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox
# Change to https://your-domain.com/api/webhooks/mpesa in production
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/webhooks/mpesa
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this AND append ?key=<same value> to MPESA_CALLBACK_URL registered with Daraja —
# without it, anyone who finds the webhook URL can forge deposit confirmations.
MPESA_WEBHOOK_SECRET=

# ── Live switches ────────────────────────────────────────
# Both default to mocked. Real money only moves when these are set explicitly,
# and the app refuses to start if it is switched live without its credentials.
# PAYMENT_MOCK=false   → payments hit real providers
# MPESA_LIVE=true      → M-Pesa hits Safaricom rather than returning mock IDs
PAYMENT_MOCK=true
MPESA_LIVE=false

# ── Bank transfer deposits ───────────────────────────────
# REQUIRED IN PRODUCTION. These are returned verbatim to the customer as their
# deposit instructions. Every one has a fallback, so leaving them unset does not
# fail — it tells people to wire money to account "XXXXXXXXXXXX".
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NO=
BANK_BRANCH=
BANK_PAYBILL=

# ── FX pricing ───────────────────────────────────────────
# What customers are charged on every currency conversion. Defaults shown.
FX_FEE_PERCENT=1
FX_SPREAD=0.005

# ── Alpaca (US equities broker) ──────────────────────────
# Paper trading: https://paper-api.alpaca.markets
# Live trading:  https://api.alpaca.markets
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Market Data (Polygon.io) ─────────────────────────────
# NOT READ BY ANY CODE. Price data comes from the Yahoo Finance feed in
# priceFeedService. Do not buy a plan for this.
POLYGON_API_KEY=

# ── Docker Compose secrets ───────────────────────────────
POSTGRES_PASSWORD=capadev
# NOT READ BY ANY CODE and not referenced by docker-compose either.
REDIS_PASSWORD=redisdev
