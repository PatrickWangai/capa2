# ── App ──────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/capa

# ── Auth.js ──────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ── Provider abstractions ────────────────────────────────
# "mock" uses the in-memory/deterministic mock implementations behind each
# provider interface (see src/services/providers). Switch to "real" only
# once a RealXService is implemented and the credentials below are set.
BROKER_PROVIDER=mock
MARKET_DATA_PROVIDER=mock
PAYMENT_PROVIDER=mock
KYC_PROVIDER=mock

# ── Real broker (Phase 6+, not yet implemented) ──────────
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Real market data (Phase 6+, not yet implemented) ─────
# POLYGON_API_KEY=

# ── Real payments (Phase 6+, not yet implemented) ────────
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=

# ── Real KYC document storage (Phase 6+, not yet implemented) ─
