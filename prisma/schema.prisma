generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RiskExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  CLOSED
}

enum Exchange {
  NSE
  NYSE
  NASDAQ
  LSE
}

enum AssetClass {
  STOCK
  ETF
  BOND
}

enum AssetRegion {
  KE
  US
  GLOBAL
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
}

enum TradeReason {
  LONG_TERM_GROWTH
  DIVIDEND
  UNDERVALUED
  TECHNICAL_SETUP
  SHORT_TERM_TRADE
  DIVERSIFICATION
  OTHER
}

enum PaymentMethod {
  MPESA
  BANK
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE_BUY
  TRADE_SELL
  FEE
  DIVIDEND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ThesisDirection {
  BULL
  BEAR
}

enum ThesisStatus {
  ACTIVE
  UPDATED
  CLOSED
  INVALIDATED
  ACHIEVED
}

enum PostType {
  THESIS
  VERIFIED_TRADE
  COMMENTARY
  QUESTION
  RESEARCH
  EDUCATIONAL
  MILESTONE
  JOURNEY_UPDATE
}

enum PostVisibility {
  PUBLIC
  PRIVATE
  FOLLOWERS
}

enum ModerationStatus {
  VISIBLE
  REPORTED
  UNDER_REVIEW
  REMOVED
  APPEALED
}

enum CircleVisibility {
  PUBLIC
  PRIVATE
}

enum CircleMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationType {
  ORDER_FILLED
  PRICE_ALERT
  COMMENT
  THESIS_SAVED
  CIRCLE_ACTIVITY
  MARKET_BRIEF
  MILESTONE
  SYSTEM
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  NEEDS_INFO
}

enum MarketEventCategory {
  EARNINGS
  DIVIDEND
  NEWS
  PRICE_MOVE
  REGULATORY
  OTHER
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

// ---------- Core identity ----------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  name         String
  avatarUrl    String?
  bio          String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile         Profile?
  account         Account?
  wallet          Wallet?
  kycApplication  KYCApplication?

  holdings        Holding[]
  orders          Order[]
  trades          Trade[]
  watchlists      Watchlist[]

  theses          Thesis[]
  thesisFollows   ThesisFollow[]
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  saves           Save[]

  following       Follow[]           @relation("follower")
  followers       Follow[]           @relation("following")
  circleMemberships CircleMember[]
  ownedCircles    Circle[]
  circlePosts     CirclePost[]
  notifications   Notification[]
  milestones      InvestmentMilestone[]
  marketBriefs    MarketBrief[]
  simulations     Simulation[]
  auditLogs       AuditLog[]
  reportsFiled    Report[]           @relation("reporter")
  blockedUsers    BlockedUser[]      @relation("blocker")
  blockedByUsers  BlockedUser[]      @relation("blocked")

  @@index([email])
  @@index([username])
}

model Profile {
  id                  String         @id @default(cuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests           String[]       @default([])
  riskExperience      RiskExperience @default(BEGINNER)
  showVerifiedTrades  Boolean        @default(false)
  showHoldings        Boolean        @default(false)
  showPortfolioValue  Boolean        @default(false)
  showTheses          Boolean        @default(true)
  allowFollow         Boolean        @default(true)
  allowComments       Boolean        @default(true)
  showJourney         Boolean        @default(true)
  followerCount       Int            @default(0)
  followingCount      Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Account {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String        @unique
  status        AccountStatus @default(ACTIVE)
  openedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ---------- Wallet / payments ----------

model Wallet {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashBalance        Decimal  @default(0) @db.Decimal(18, 4)
  pendingDeposits    Decimal  @default(0) @db.Decimal(18, 4)
  pendingWithdrawals Decimal  @default(0) @db.Decimal(18, 4)
  currency           String   @default("KES")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deposits     Deposit[]
  withdrawals  Withdrawal[]
  transactions Transaction[]
}

model Deposit {
  id          String        @id @default(cuid())
  walletId    String
  wallet      Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(18, 4)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Withdrawal {
  id          String        @id @default(cuid())
  walletId    String
  wallet      Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(18, 4)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Transaction {
  id            String             @id @default(cuid())
  walletId      String
  wallet        Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal            @db.Decimal(18, 4)
  status        TransactionStatus  @default(COMPLETED)
  description   String?
  relatedOrderId String?
  createdAt     DateTime           @default(now())

  @@index([walletId])
}

// ---------- Markets & assets ----------

model Market {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  timezone  String
  openTime  String
  closeTime String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id               String      @id @default(cuid())
  symbol           String      @unique
  name             String
  exchange         Exchange
  assetClass       AssetClass
  region           AssetRegion
  sector           String?
  currency         String
  currentPrice     Decimal     @db.Decimal(18, 4)
  previousClose    Decimal     @db.Decimal(18, 4)
  dayChangePercent Decimal     @db.Decimal(9, 4)
  marketCap        Decimal?    @db.Decimal(24, 2)
  peRatio          Decimal?    @db.Decimal(9, 2)
  dividendYield    Decimal?    @db.Decimal(9, 4)
  week52High       Decimal?    @db.Decimal(18, 4)
  week52Low        Decimal?    @db.Decimal(18, 4)
  logoUrl          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  holdings        Holding[]
  orders          Order[]
  trades          Trade[]
  watchlistItems  WatchlistItem[]
  theses          Thesis[]
  marketEvents    MarketEvent[]
  simulationPositions SimulationPosition[]

  @@index([region])
  @@index([assetClass])
}

model MarketEvent {
  id         String              @id @default(cuid())
  assetId    String?
  asset      Asset?              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title      String
  summary    String
  category   MarketEventCategory
  occurredAt DateTime
  createdAt  DateTime            @default(now())

  @@index([assetId])
}

// ---------- Portfolio & trading ----------

model Holding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity  Decimal  @db.Decimal(18, 6)
  avgPrice  Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, assetId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  side            OrderSide
  type            OrderType
  quantity        Decimal     @db.Decimal(18, 6)
  limitPrice      Decimal?    @db.Decimal(18, 4)
  estimatedTotal  Decimal     @db.Decimal(18, 4)
  fee             Decimal     @db.Decimal(18, 4)
  status          OrderStatus @default(PENDING)
  reason          TradeReason?
  filledAt        DateTime?
  filledPrice     Decimal?    @db.Decimal(18, 4)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  trade Trade?

  @@index([userId])
  @@index([assetId])
  @@index([status])
}

model Trade {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  side       OrderSide
  quantity   Decimal   @db.Decimal(18, 6)
  price      Decimal   @db.Decimal(18, 4)
  fee        Decimal   @db.Decimal(18, 4)
  executedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  posts   Post[]
  theses  Thesis[]

  @@index([userId])
  @@index([assetId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([watchlistId, assetId])
}

// ---------- Investment theses ----------

model Thesis {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  direction      ThesisDirection
  title          String
  entryPrice     Decimal         @db.Decimal(18, 4)
  targetPrice    Decimal?        @db.Decimal(18, 4)
  timeHorizon    String
  reason         TradeReason
  body           String
  riskFactors    String?
  status         ThesisStatus    @default(ACTIVE)
  verifiedTradeId String?
  verifiedTrade  Trade?          @relation(fields: [verifiedTradeId], references: [id])
  likeCount      Int             @default(0)
  commentCount   Int             @default(0)
  saveCount      Int             @default(0)
  followCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions ThesisVersion[]
  follows  ThesisFollow[]
  posts    Post[]

  @@index([assetId])
  @@index([userId])
}

model ThesisVersion {
  id          String       @id @default(cuid())
  thesisId    String
  thesis      Thesis       @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  body        String
  targetPrice Decimal?     @db.Decimal(18, 4)
  status      ThesisStatus
  createdAt   DateTime     @default(now())

  @@index([thesisId])
}

model ThesisFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thesisId  String
  thesis    Thesis   @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, thesisId])
}

// ---------- Social feed ----------

model Post {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             PostType
  visibility       PostVisibility    @default(PUBLIC)
  content          String
  thesisId         String?
  thesis           Thesis?           @relation(fields: [thesisId], references: [id])
  tradeId          String?
  trade            Trade?            @relation(fields: [tradeId], references: [id])
  moderationStatus ModerationStatus  @default(VISIBLE)
  likeCount        Int               @default(0)
  commentCount     Int               @default(0)
  saveCount        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  comments Comment[]
  likes    Like[]
  saves    Save[]
  reports  Report[]

  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId           String
  post             Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  body             String
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  reports Report[]

  @@index([postId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// ---------- Circles ----------

model Circle {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String
  visibility  CircleVisibility  @default(PUBLIC)
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id])
  memberCount Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     CircleMember[]
  posts       CirclePost[]
  simulations Simulation[]
}

model CircleMember {
  id       String           @id @default(cuid())
  circleId String
  circle   Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     CircleMemberRole @default(MEMBER)
  joinedAt DateTime         @default(now())

  @@unique([circleId, userId])
}

model CirclePost {
  id        String   @id @default(cuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circleId])
}

// ---------- Simulation ----------

model Simulation {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  circleId        String?
  circle          Circle?  @relation(fields: [circleId], references: [id])
  name            String
  startingCapital Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  positions SimulationPosition[]
}

model SimulationPosition {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity     Decimal    @db.Decimal(18, 6)
  avgPrice     Decimal    @db.Decimal(18, 4)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([simulationId, assetId])
}

// ---------- Notifications, briefs, journey ----------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model MarketBrief {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt DateTime @default(now())
  summary     String
  highlights  Json
  createdAt   DateTime @default(now())

  @@index([userId])
}

model InvestmentMilestone {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  occurredAt  DateTime
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ---------- KYC ----------

model KYCApplication {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             KYCStatus @default(NOT_STARTED)
  fullName           String?
  dateOfBirth        DateTime?
  idNumber           String?
  idDocumentUrl      String?
  addressDocumentUrl String?
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ---------- Admin / moderation ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

model Report {
  id           String            @id @default(cuid())
  reporterId   String
  reporter     User              @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  postId       String?
  post         Post?             @relation(fields: [postId], references: [id])
  commentId    String?
  comment      Comment?          @relation(fields: [commentId], references: [id])
  targetUserId String?
  reason       String
  status       ModerationStatus  @default(REPORTED)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([status])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}
